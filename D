wf_prefix = tuple(wf_cols)

# overall, split by asc only
asc_overall_averages = (
    combined_df.groupby("asc")[
        [c for c in combined_df.columns if c.startswith(wf_prefix)]
    ].mean().reset_index()
)

# asc x channel
asc_channel_averages = (
    combined_df.groupby(["asc", "drv_chnl_of_bnd"])[
        [c for c in combined_df.columns if c.startswith(wf_prefix)]
    ].mean().reset_index()
)


def asc_label(v):
    return "ASC" if v == 1 else "Classic"   # CONFIRM 1==ASC before shipping




for asc_val in sorted(asc_overall_averages["asc"].unique()):
