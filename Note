Drift Color CSI =
VAR v = SELECTEDVALUE ( csi_df[CSI] )
RETURN SWITCH ( TRUE (),
    ISBLANK ( v ), "#5F5E5A",
    v > 0.25, "#A32D2D",
    v > 0.1,  "#B7791F",
    "#1D6F42" )


Drift Color PSI =
VAR v = SELECTEDVALUE ( psi_df[PSI] )
RETURN SWITCH ( TRUE (),
    ISBLANK ( v ), "#5F5E5A",
    v > 0.25, "#A32D2D",
    v > 0.1,  "#B7791F",
    "#1D6F42" )
