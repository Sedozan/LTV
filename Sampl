# --- Termination diagnostics + sample selection -----------------------------
# Column names are from your renters schema; adjust if `pre` still uses raw names.
PRE_KEY   = "policyNbr"           # policy col in pre-dedup snapshot
NEW_KEY   = "ply_policy_nbr"      # policy col in deduped output
TERM_COL  = "drv_termination_dt"
ENDT_COL  = "drv_endorse_dt"
PREM_PRE  = "totalPremiumAmtStr"  # premium col in `pre` (may be raw; check schema)

# 1) How over-represented are terminated policies among deduped policies?
dup_pols_df = pre.groupBy(PRE_KEY).count().filter("count > 1").select(PRE_KEY)
term_pols_df = new.filter(f"{TERM_COL} is not null").select(NEW_KEY).distinct()

n_dup = dup_pols_df.count()
n_dup_term = dup_pols_df.join(
    term_pols_df, dup_pols_df[PRE_KEY] == term_pols_df[NEW_KEY]
).count()
print("policies with dups        :", n_dup)
print("of those, terminated      :", n_dup_term)
print("terminated share of dups  :", round(n_dup_term / n_dup, 3) if n_dup else None)

# 2) BUG CHECK — no surviving row should be dated after termination. Must be 0.
post_term_survivors = new.filter(
    f"{TERM_COL} is not null and {ENDT_COL} > {TERM_COL}"
).count()
print("post-termination survivors (want 0):", post_term_survivors)

# 3) Sample selection for write-up: one dup policy WITH a premium change,
#    plus flag whether it's terminated — pick 2.
dup_prem = (
    pre.groupBy(PRE_KEY)
    .agg(
        F.count("*").alias("n_rows"),
        F.countDistinct(PREM_PRE).alias("n_prem"),
    )
    .filter("n_rows > 1 and n_prem > 1")   # multiple versions AND premium changed
    .limit(2)
    .collect()
)
sample_pols = [r[PRE_KEY] for r in dup_prem]
print("sample policies (premium change):", sample_pols)
