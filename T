# --- coverage: every scored line must have a fit -------------------------
assert set(df.drv_line) <= set(spl_fits), set(df.drv_line) - set(spl_fits)

# --- level check: ratio test cancels scale, this doesn't -----------------
lvl = []
for line, g in df.groupby("drv_line"):
    exp0 = eval_fit(0, line, spl_fits)
    lvl.append({
        "drv_line": line,
        "expected_loss_0": exp0,
        "obs_loss_0_max_gap": (g["loss_0"] - exp0).abs().max(),
    })
lvl = pd.DataFrame(lvl)
assert (lvl["obs_loss_0_max_gap"] < 1e-4).all(), lvl
lvl.round(6)

# --- sensitivity control: confirms the 1e-6 test would fail on old fits ---
chk_prod = []
for line, g in df.groupby("drv_line"):
    base = g["loss_0"]
    for n in [2, 4, 9]:
        exp = eval_fit(n, line, prod_fits) / eval_fit(0, line, prod_fits)
        obs = (g[f"loss_{n}"] / base).replace([np.inf, -np.inf], np.nan)
        chk_prod.append(
            {"drv_line": line, "n": n, "max_gap_vs_prod": (obs - exp).abs().max()}
        )
chk_prod = pd.DataFrame(chk_prod)
assert (chk_prod["max_gap_vs_prod"] > 1e-3).all(), chk_prod
chk_prod.pivot_table(
    index="drv_line", columns="n", values="max_gap_vs_prod"
).round(6)
